<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <payment>
            <secureframe>
                <active>0</active>
                <model>SecurePay\SecureFrame\Model\SecureFrame</model>
                <group>secureframe</group>
                <title>Payment via SecurePay SecureFrame</title>
                <payment_action>authorize_capture</payment_action>
                <order_status>pending_payment</order_status>
                <test_mode>1</test_mode>
                <transaction_type>0</transaction_type>
                <accepted_card_types>VISA,MASTERCARD</accepted_card_types>
                <currency_accepted>A</currency_accepted>
                <allowspecific>0</allowspecific>
                <sort_order>10</sort_order>
                <can_authorize>1</can_authorize>
                <can_capture>1</can_capture>
            </secureframe>
        </payment>
    </default>
</config>
