<?php
/**
 * @var \SecurePay\SecureFrame\Block\Redirect $block
 * @var \Magento\Framework\Escaper $escaper
 */
$fields = $block->getFields();
?>
<form id="secureframe-redirect" action="<?= $escaper->escapeUrl($block->getActionUrl()) ?>" method="post">
    <?php foreach ($fields as $name => $value): ?>
        <input type="hidden" name="<?= $escaper->escapeHtmlAttr($name) ?>" value="<?= $escaper->escapeHtmlAttr($value) ?>"/>
    <?php endforeach; ?>
    <p><?= $escaper->escapeHtml(__('Redirecting to SecurePay.')) ?></p>
</form>
<script>
    document.getElementById('secureframe-redirect').submit();
</script>
