<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="yd_wholesales" translate="label" sortOrder="220" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Wholesale Applications</label>
            <tab>general</tab>
            <resource>Yd_Wholesales::config</resource>
            <group id="email" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Notification</label>
                <field id="recipient" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Recipient email</label>
                    <comment>Applications are sent here. The address is not stored in code.</comment>
                    <validate>validate-email</validate>
                </field>
                <field id="recipient_name" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Recipient name</label>
                </field>
                <field id="identity" translate="label" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Sender</label>
                    <source_model>Magento\Config\Model\Config\Source\Email\Identity</source_model>
                </field>
            </group>
        </section>
    </system>
</config>
