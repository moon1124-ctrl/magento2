<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="yd_shopping" translate="label" sortOrder="250" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Google Shopping</label>
            <tab>catalog</tab>
            <resource>Yd_ShoppingFeed::config</resource>
            <group id="feed" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Product feed</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="token" translate="label" type="obscure" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Feed token</label>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <comment>Google fetches /shoppingfeed/index/index?token=THIS</comment>
                </field>
            </group>
        </section>
    </system>
</config>
